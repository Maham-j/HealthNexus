# Neo4j connection
NEO4J_URI=your_neo4j_uri_here
NEO4J_USER=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=your_neo4j_database_here

# LLM provider
LLM_PROVIDER=your_llm_provider_here
API_KEY=your_api_key_here

# Auth / JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=your_jwt_algorithm_here
ACCESS_TOKEN_EXPIRE_MINUTES=your_access_token_expiry_minutes_here
